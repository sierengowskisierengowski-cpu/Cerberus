package main

import (
	"bytes"
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net/http"
	"strings"
	"time"
)

// The Unified Lightweight Local Brain. This model uses minimal RAM and runs in milliseconds.
const UnifiedLocalBrain = "qwen2.5-coder:7b"

type SecurityLog struct {
	PID            uint32 `json:"pid"`
	PPID           uint32 `json:"ppid"`
	UID            uint32 `json:"uid"`
	ParentProcess  string `json:"parent_process"`
	BinaryExecuted string `json:"binary_executed"`
}

type OllamaRequest struct {
	Model  string `json:"model"`
	Prompt string `json:"prompt"`
	Stream bool   `json:"stream"`
}

type OllamaResponse struct {
	Response string `json:"response"`
}

// CleanAIResponse safely strips away intermediate reasoning/thinking tags from local models
func CleanAIResponse(rawResponse string) string {
	if strings.Contains(rawResponse, "</thought>") {
		parts := strings.Split(rawResponse, "</thought>")
		return strings.TrimSpace(parts[len(parts)-1])
	}
	return strings.TrimSpace(rawResponse)
}

// QueryLocalAI sends our security context to the local Ollama service (100% offline)
func QueryLocalAI(secLog SecurityLog, rolePrompt string, contextPrompt string) {
	// Combine the dynamic system role prompt with the current event data
	fullPrompt := fmt.Sprintf("%s\n\nEvent Context:\nParent Process: %s (PID: %d)\nExecuted Binary: %s (PID: %d)\nUser ID: %d\n\nProvide your analysis now:",
		rolePrompt, secLog.ParentProcess, secLog.PPID, secLog.BinaryExecuted, secLog.PID, secLog.UID)

	requestBody, err := json.Marshal(OllamaRequest{
		Model:  UnifiedLocalBrain,
		Prompt: fullPrompt,
		Stream: false,
	})
	if err != nil {
		log.Printf("[!] Failed to package AI payload: %v", err)
		return
	}

	resp, err := http.Post("http://127.0.0", "application/json", bytes.NewBuffer(requestBody))
	if err != nil {
		log.Printf("[!] Local AI engine unreachable. Make sure Ollama is running: %v", err)
		return
	}
	defer resp.Body.Close()

	body, _ := io.ReadAll(resp.Body)
	var ollamaResp OllamaResponse
	if err := json.Unmarshal(body, &ollamaResp); err != nil {
		log.Printf("[!] Failed to decode AI JSON: %v", err)
		return
	}

	cleanVerdict := CleanAIResponse(ollamaResp.Response)
	fmt.Printf("\n[🤖 COGNITIVE ANALYSIS]: %s\n\n", cleanVerdict)
}

func main() {
	log.Println("[+] Cerberus Command Tower (Right Head) waking up...")
	log.Println("[+] Local telemetry pipeline active on port 8080...")

	http.HandleFunc("/telemetry", func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodPost {
			http.Error(w, "Invalid method", http.StatusMethodNotAllowed)
			return
		}

		var secLog SecurityLog
		if err := json.NewDecoder(r.Body).Decode(&secLog); err != nil {
			http.Error(w, err.Error(), http.StatusBadRequest)
			return
		}

		fmt.Printf("[%s] [INGESTION] Log received: Process '%s' spawned '%s'\n",
			time.Now().Format("15:04:05"), secLog.ParentProcess, secLog.BinaryExecuted)

		// Define the specific operational context role we want the unified model to assume
		tacticalRolePrompt := "You are Cerberus-Tactical, an automated endpoint defense coordinator. Analyze the following telemetry. If the command executed looks malicious, stealthy, or unexpected, state 'VERDICT: MALICIOUS'. Otherwise state 'VERDICT: SAFE'."

		// Offload the reasoning step to an asynchronous thread so our ingestion loop never slows down
		go QueryLocalAI(secLog, tacticalRolePrompt, secLog.BinaryExecuted)

		w.WriteHeader(http.StatusOK)
		w.Write([]byte(`{"status":"received"}`))
	})

	if err := http.ListenAndServe("127.0.0.1:8080", nil); err != nil {
		log.Fatalf("[!] Command Tower network pipeline dropped: %v", err)
	}
}
