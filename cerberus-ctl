#!/usr/bin/env bash
# Cerberus Terminal Control Center (TUI Menu)
# Created by Joseph Sierengowski

set -uo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Service names
SERVER_SERVICE="cerberus-server"
AGENT_SERVICE="cerberus-agent"
DECEPTION_SERVICE="cerberus-deception"
ENV_FILE="/etc/cerberus/agent.env"

# Dependency Check
if ! command -v curl &>/dev/null; then
    echo -e "${RED}[!] Error: 'curl' is required for cerberus-ctl. Please install it.${NC}"
    exit 1
fi

if ! command -v python3 &>/dev/null && ! command -v jq &>/dev/null; then
    echo -e "${RED}[!] Error: 'python3' or 'jq' is required to parse JSON replies in cerberus-ctl.${NC}"
    exit 1
fi

show_header() {
    clear
    echo -e "${CYAN}${BOLD}"
    echo "  ▄████▄  ██████  ██▀███   ▄▄▄▄   ▓█████  ██▀███   █    ██   ██████ "
    echo " ▒██▀ ▀█ ▓██    ▒▓██ ▒ ██▒▓█████▄ ▓█   ▀ ▓██ ▒ ██▒ ██  ▓██▒▒██    ▒ "
    echo " ▒▓█    ▄▒████ ░ ▓██ ░▄█ ▒▒██▒ ▄██▒███   ▓██ ░▄█ ▒▓██  ▒██░░ ▓██▄   "
    echo " ▒▓▓▄ ▄██▒██▓ ░  ▒██▀▀█▄  ▒██░█▀  ▒▓█  ▄ ▒██▀▀█▄  ▓▓█  ░██░  ▒   ██▒"
    echo "  ▒ ▓███▀ ░██████▒░██▓ ▒██▒░▓█  ▀█▓░▒████▒░██▓ ▒██▒▒▒█████▓ ▒██████▒▒"
    echo "  ░ ░ ▒   ░ ▒░▓  ░░ ▒▓ ░▒▓░░▒▓███▀▒░ ▒░ ░░ ▒▓ ░▒▓░░▒▓ ▒ ▒  ▒ ▒▓▒ ▒ ░"
    echo "    ░ ▒   ░ ░ ▒  ░  ░▒ ░ ▒░ ▒░▒   ░  ░ ░  ░  ░▒ ░ ▒░░▒░ ░ ░  ░ ░▒  ░ ░"
    echo "  ░         ░ ░     ░░   ░   ░    ░    ░     ░░   ░  ░░ ░ ░  ░  ░  ░  "
    echo "  ░           ░  ░   ░       ░         ░  ░   ░       ░            ░ "
    echo "  ░                               ░                                  "
    echo -e "${NC}"
    echo -e "${BOLD}========================================================================${NC}"
    echo -e "${BOLD}       CERBERUS OPERATIONAL CONTROL CENTER | BY JOSEPH SIERENGOWSKI${NC}"
    echo -e "${BOLD}========================================================================${NC}"
    echo ""
}

get_status_label() {
    local service=$1
    if systemctl is-active --quiet "$service" 2>/dev/null; then
        echo -e "${GREEN}ACTIVE (RUNNING)${NC}"
    else
        echo -e "${RED}INACTIVE (STOPPED)${NC}"
    fi
}

get_autokill_status() {
    if [ -f "$ENV_FILE" ] && grep -q "CERBERUS_ENABLE_AUTOKILL=1" "$ENV_FILE"; then
        echo -e "${RED}${BOLD}ENABLED (AUTO-SIGKILL)${NC}"
    else
        echo -e "${GREEN}DISABLED (OBSERVATION MODE)${NC}"
    fi
}

service_control_menu() {
    while true; do
        show_header
        echo -e "${BOLD}--- SERVICE CONTROL PANEL ---${NC}"
        echo -e "1) Go Command Tower:      $(get_status_label $SERVER_SERVICE)"
        echo -e "2) eBPF Rust Agent:       $(get_status_label $AGENT_SERVICE)"
        echo -e "3) Deception Maze:        $(get_status_label $DECEPTION_SERVICE)"
        echo ""
        echo "Select a service to toggle (1-3) or 'b' to go back:"
        read -p "choice> " svc_choice

        case "$svc_choice" in
            1)
                if systemctl is-active --quiet "$SERVER_SERVICE" 2>/dev/null; then
                    echo "Stopping $SERVER_SERVICE..."
                    sudo systemctl stop "$SERVER_SERVICE"
                else
                    echo "Starting $SERVER_SERVICE..."
                    sudo systemctl start "$SERVER_SERVICE"
                fi
                sleep 1
                ;;
            2)
                if systemctl is-active --quiet "$AGENT_SERVICE" 2>/dev/null; then
                    echo "Stopping $AGENT_SERVICE..."
                    sudo systemctl stop "$AGENT_SERVICE"
                else
                    echo "Starting $AGENT_SERVICE..."
                    sudo systemctl start "$AGENT_SERVICE"
                fi
                sleep 1
                ;;
            3)
                if systemctl is-active --quiet "$DECEPTION_SERVICE" 2>/dev/null; then
                    echo "Stopping $DECEPTION_SERVICE..."
                    sudo systemctl stop "$DECEPTION_SERVICE"
                else
                    echo "Starting $DECEPTION_SERVICE..."
                    sudo systemctl start "$DECEPTION_SERVICE"
                fi
                sleep 1
                ;;
            b|B)
                break
                ;;
            *)
                echo "Invalid selection."
                sleep 1
                ;;
        esac
    done
}

toggle_autokill() {
    show_header
    echo -e "${BOLD}--- TOGGLE AUTONOMOUS AUTOKILL ---${NC}"
    echo -e "Current Autokill Status: $(get_autokill_status)"
    echo ""
    echo "1) Enable Autokill (Auto-SIGKILL suspicious executions)"
    echo "2) Disable Autokill (Observation / Audit-Only mode)"
    echo "b) Go back"
    echo ""
    read -p "choice> " ak_choice

    case "$ak_choice" in
        1)
            sudo mkdir -p "$(dirname "$ENV_FILE")"
            echo "CERBERUS_ENABLE_AUTOKILL=1" | sudo tee "$ENV_FILE" >/dev/null
            echo "Autokill enabled. Restarting Cerberus agent..."
            sudo systemctl restart "$AGENT_SERVICE" 2>/dev/null || true
            echo "Done."
            sleep 1.5
            ;;
        2)
            sudo mkdir -p "$(dirname "$ENV_FILE")"
            echo "CERBERUS_ENABLE_AUTOKILL=0" | sudo tee "$ENV_FILE" >/dev/null
            echo "Autokill disabled. Restarting Cerberus agent..."
            sudo systemctl restart "$AGENT_SERVICE" 2>/dev/null || true
            echo "Done."
            sleep 1.5
            ;;
        *)
            ;;
    esac
}

view_logs() {
    show_header
    echo -e "${BOLD}--- REAL-TIME TELEMETRY LOGS (Press Ctrl+C to exit) ---${NC}"
    echo ""
    if [ -f "/var/log/cerberus/telemetry.json" ]; then
        echo -e "${YELLOW}[i] Tailing formatted JSONL telemetry database...${NC}\n"
        sudo tail -n 20 -f "/var/log/cerberus/telemetry.json" 2>/dev/null | python3 -c '
import sys, json
for line in sys.stdin:
    try:
        data = json.loads(line.strip())
        print(f"\033[36m[{data.get(\"timestamp\", \"\")}]\033[0m \033[1mPID: {data.get(\"pid\", \"\")}\033[0m Executed: \033[32m{data.get(\"binary_executed\", \"\")}\033[0m (Parent: {data.get(\"parent_process\", \"\")})")
        sys.stdout.flush()
    except Exception:
        print(line.strip())
        sys.stdout.flush()
' 2>/dev/null || sudo journalctl -u "$AGENT_SERVICE" -n 20 -f
    else
        echo "No persistent telemetry.json found yet. Tailing journald logs..."
        sudo journalctl -u "$AGENT_SERVICE" -n 20 -f
    fi
}

ask_ai() {
    show_header
    echo -e "${BOLD}--- ASK CERBERUS SECURITY AI ---${NC}"
    echo "Query the local consensus intelligence model regarding host performance,"
    echo "storage limits, memory exhaustion, or telemetry findings."
    echo ""
    echo "Example questions:"
    echo " - Is the system running low on RAM or disk space?"
    echo " - What suspicious events have you found so far?"
    echo " - Give me a security diagnostic summary."
    echo ""
    read -p "Ask Cerberus AI > " ai_query

    if [ -n "$ai_query" ]; then
        echo -e "\n${YELLOW}Connecting to Cerberus Command Tower AI Engine...${NC}"
        local response
        response=$(curl -s -X POST -H "Content-Type: application/json" -d "{\"question\": \"$ai_query\"}" http://127.0.0.1:8080/ask)
        
        if [ $? -ne 0 ] || [ -z "$response" ]; then
            echo -e "\n${RED}[!] Error: Could not connect to Go Command Tower at http://127.0.0.1:8080.${NC}"
            echo -e "Please ensure the $SERVER_SERVICE service is running."
        else
            echo -e "\n${GREEN}${BOLD}--- AI COGNITIVE REPORT ---${NC}\n"
            echo "$response" | python3 -c "import sys, json; print(json.load(sys.stdin).get('answer', 'Error parsing AI reply.'))" 2>/dev/null || echo "$response"
        fi
        echo ""
        read -p "Press [Enter] to return to menu..." _dummy
    fi
}

# Main menu loop
while true; do
    show_header
    echo -e "${BOLD}--- SYSTEM HEALTH & INTEGRITY ---${NC}"
    echo -e "Go Command Tower:      $(get_status_label $SERVER_SERVICE)"
    echo -e "eBPF Rust Agent:       $(get_status_label $AGENT_SERVICE)"
    echo -e "Deception Maze:        $(get_status_label $DECEPTION_SERVICE)"
    echo -e "Autonomous Response:   $(get_autokill_status)"
    echo ""
    echo -e "${BOLD}--- OPERATION MENU ---${NC}"
    echo "1) Service Management (Start/Stop)"
    echo "2) Toggle Autonomous Kill (Autokill)"
    echo "3) Real-Time Telemetry Log Viewer"
    echo "4) Ask Cerberus Security AI (RAM, Disk, Events)"
    echo "5) Exit"
    echo ""
    read -p "select option (1-5)> " main_choice

    case "$main_choice" in
        1)
            service_control_menu
            ;;
        2)
            toggle_autokill
            ;;
        3)
            view_logs
            ;;
        4)
            ask_ai
            ;;
        5)
            echo "Exiting Cerberus Control Center."
            exit 0
            ;;
        *)
            echo "Invalid selection."
            sleep 1
            ;;
    esac
done
